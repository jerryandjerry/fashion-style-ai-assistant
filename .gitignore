# Data: keep sample data, ignore downloaded/processed large files by default
/data/external/**
/data/processed/**
!/data/external/.gitkeep
!/data/processed/.gitkeep
# Data is ignored; the code and manifests that produce it are not.
!/data/external/**/
!/data/processed/**/
!/data/**/*.py
!/data/**/*_manifest.json

